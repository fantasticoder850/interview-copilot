# No server-wide Anthropic key: each user sets their own key in Account
# settings, and every Claude call is billed to that user's own key.

# PostgreSQL (host port 9013 → container 5432, see docker-compose.yml)
DATABASE_URL=postgresql://interview:interview@localhost:9013/interview_assistant

# Port the backend listens on
PORT=9011

# Secret used to sign session cookies (use a long random string)
JWT_SECRET=

# The initial admin is seeded by the database migration
# (server/src/migrations/002_seed_admin.sql), not by env.
